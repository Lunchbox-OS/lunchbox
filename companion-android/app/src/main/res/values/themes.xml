<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the entire UI with Material 3; the Activity theme
         only needs to be a no-action-bar splash background. Parented to
         the framework DeviceDefault theme so we avoid a dependency on the
         com.google.android.material XML theme library. -->
    <style name="Theme.ShepherdCompanion" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
