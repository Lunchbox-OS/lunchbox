# Android CI image for shepherd-launcher.
#
# Layers the JDK + Android SDK on top of the base CI image (.ci/Dockerfile)
# so the companion-android Gradle jobs get a ready SDK without every
# Rust-only job paying the ~1 GB pull. The base image — including its own
# year-week + content hash — is passed in via the BASE_IMAGE build arg by
# the `image-android` workflow job, which rebuilds this layer on a
# content-hash miss.
#
# Tag scheme mirrors the base image: `<isoyear>w<isoweek>-<sha256-12>`,
# here over .ci/Dockerfile.android, scripts/deps/android.pkgs,
# scripts/lib/deps.sh, and the base image ref (so a base rebuild forces
# an Android rebuild too).

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

# Install the JDK + unzip (android.pkgs) and download the Android SDK
# into /opt/android-sdk via the project's own installer, so the image
# stays in lockstep with `./scripts/shepherd deps install android` on a
# host. curl (used to fetch the cmdline-tools) is already present from
# the base image's build deps. Re-copy scripts so this layer reflects
# the current checkout rather than whatever the base image baked.
COPY scripts /opt/shepherd-deps/scripts
WORKDIR /opt/shepherd-deps
RUN ./scripts/shepherd deps install android && \
    rm -rf /var/lib/apt/lists/*

# AGP and the Gradle jobs resolve the SDK from this (local.properties is
# gitignored and absent in CI). Matches where the installer drops it.
ENV ANDROID_SDK_ROOT=/opt/android-sdk

# The NDK cargo-ndk cross-compiles the shepherd-media-android cdylib with.
# Set explicitly (rather than relying on cargo-ndk's auto-detect heuristic) so
# the build never depends on it and no job has to compute the path. cargo-ndk
# itself + the Android Rust targets are baked in by `deps install android`
# above. Keep the version in sync with ANDROID_NDK_VERSION in
# scripts/lib/deps.sh (either change rebuilds this image via the content hash).
ENV ANDROID_NDK_HOME=/opt/android-sdk/ndk/27.2.12479018

WORKDIR /
