# Grant the 'input' group read/write access to /dev/uinput so an unprivileged
# lunchbox user can create virtual input devices. The touch-to-mouse,
# tablet-to-touch, and gamepad sidecars (lunchbox-touch-bridge,
# lunchbox-tablet-bridge, lunchbox-gamepad-bridge) synthesize input through
# uinput, which works on any Wayland compositor (and X11), unlike the
# wlroots-only protocols used before (issue #58).
#
# Membership in the 'input' group is granted by `lunchbox install groups`.
# static_node ensures the node exists with these permissions even though
# uinput is usually an on-demand kernel module loaded only when first opened.
KERNEL=="uinput", SUBSYSTEM=="misc", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"
