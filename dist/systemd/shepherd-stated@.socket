# The socket shepherdd reaches shepherd's state custodian on (issue #157).
#
# Templated on the kiosk user: `shepherd-stated@kiosk.socket` serves the state
# of the user `kiosk`, whose graphical session is the only cgroup the daemon
# will talk to.
#
# **The service manager creates this socket, not the daemon**, and that is the
# point rather than a convenience. `docs/ai/history/2026-08-29 004`'s finding 2
# measured an activity `unlink()`ing shepherdd's own management socket and
# binding an impostor in its place — possible because that socket lives in a
# directory at the child's own uid, where no file mode can help. Its conclusion
# was that preventing it "requires the socket to be created by something other
# than the daemon, i.e. systemd socket activation with root binding it and
# passing the fd, which `shepherdd` cannot use while sway `exec`s it".
#
# This daemon can. `/run/shepherdd/state/` is created by the system manager and
# owned by root, so nothing at the kiosk uid can take the name.
#
# Socket-activated so the daemon is not a process running all the time for no
# reason: it starts when shepherdd first connects, and the state it guards is
# untouchable in the meantime because it is untouchable by ownership, not by
# anything the daemon is doing.

[Unit]
Description=Socket for shepherd's state custodian (user %i)
Documentation=https://git.armeafamily.com/albert/shepherd-launcher/issues/157

[Socket]
ListenStream=/run/shepherdd/state/%i.sock

# Connecting to a Unix socket needs *write* permission on the inode, and
# shepherdd is at a different uid than this daemon — so the mode has to be
# permissive for it to connect at all.
#
# That is deliberate: the peer check is the gate, and the file mode is not.
# Anything stricter would have to be either owner-only (locking shepherdd out)
# or shared with a group the kiosk user is in — which every activity is in too,
# making it decorative. Pretending otherwise would be the same mistake as the
# uid check #144 replaced.
SocketMode=0666

[Install]
WantedBy=sockets.target
