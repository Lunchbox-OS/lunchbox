<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<!--
  Polkit action declaration for shepherd-waydroid-helper.

  Together with the rules file at dist/polkit/50-shepherd-waydroid.rules,
  this lets shepherdd invoke the helper as root (via pkexec) without a
  password prompt, but only for members of the `shepherd-waydroid` group.

  Install path: /usr/share/polkit-1/actions/org.shepherd.waydroid.policy
-->
<policyconfig>

  <vendor>Shepherd Launcher</vendor>
  <vendor_url>https://git.armeafamily.com/albert/shepherd-launcher</vendor_url>

  <!--
    One action covers every helper subcommand because polkit's
    `org.freedesktop.policykit.exec.path` annotation gates execution of the
    binary as a whole, regardless of argv. This is safe because the binary
    itself only performs narrow, fixed actions whose sole caller-controlled
    input (an Android package name) is validated against a strict allowlist.
  -->
  <action id="org.shepherd.waydroid.helper">
    <description>Manage Android (Waydroid) activities for shepherd-launcher</description>
    <message>Authentication is required to manage Android activities.</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/shepherd-waydroid-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>

</policyconfig>
