// Polkit rule for shepherd-waydroid-helper.
//
// Grants the action `org.shepherd.waydroid.helper` (declared in
// /usr/share/polkit-1/actions/org.shepherd.waydroid.policy) without a password
// prompt to members of the unix group `shepherd-waydroid`.
//
// Install path: /etc/polkit-1/rules.d/50-shepherd-waydroid.rules
//
// Setup notes:
//   1. Create the group:   sudo groupadd --system shepherd-waydroid
//   2. Add the kiosk user: sudo usermod -aG shepherd-waydroid <user>
//   3. The user must log out and back in for the supplementary group to take
//      effect, OR shepherdd must be restarted from a fresh session.

polkit.addRule(function(action, subject) {
    if (action.id === "org.shepherd.waydroid.helper" &&
        subject.isInGroup("shepherd-waydroid")) {
        return polkit.Result.YES;
    }
});
