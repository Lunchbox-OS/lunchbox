<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fullscreen, and allow the window to extend into the display cutout on
         the short edges (where a landscape camera cutout sits). The app insets
         its own content to the safe area (see src/insets.rs), so the background
         fills the whole non-rectangular display while nothing important lands
         under the camera or the rounded corners. The cutout-mode attribute is
         ignored on API < 28. -->
    <style name="Theme.LunchboxMedia" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>

        <!-- The window needs an alpha channel so the video SurfaceView behind
             it (see LunchboxMediaActivity) shows through wherever the GL side
             leaves pixels transparent.

             This has to come from the theme rather than a runtime
             Window.setFormat: NativeActivity.onCreate sets RGB_565 itself, so
             setting it beforehand has no effect, and setting it afterwards
             recreates the native window mid-startup. Declaring it here means
             the window is created translucent once and never reconfigured. -->
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
