#
#           # Create the release; if it already exists (a re-run), fetch it.
#           code="$(curl -sS -o /tmp/rel.json -w '%{http_code}' -X POST "${api}/releases" \
#             -H "$auth" -H 'Content-Type: application/json' \
#             -d "$(jq -n --arg t "$TAG" --argjson pre "$prerelease" \
#                     '{tag_name:$t, name:$t, draft:false, prerelease:$pre}')" || true)"
