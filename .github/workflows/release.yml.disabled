#     uses: ./.github/workflows/image.yml
#     with:
#       kind: cross
#       base-ref: ${{ needs.image-base.outputs.ref }}
#       target-arch: arm64
#     permissions:
#       packages: write
#     secrets: inherit
#
#   # --------------------------------------------------------------------------
#   # deb: stage the install tree via install.sh (DESTDIR) and dpkg-deb it, then
#   # (on publish) upload it + a .sha256 to the release.
#   # --------------------------------------------------------------------------
#   deb:
#     # The interpolation in `name:` is required, not cosmetic: two jobs in one
#     # workflow file may not share a name — Forgejo rejects the *entire* file
#     # when they do, and nothing in it runs. scripts/ci/check-workflows.sh
#     # catches that locally.
#     name: Build .deb (${{ matrix.arch }})
#     # Both images: the matrix picks the cross one for arm64 and the base one for
#     # amd64, and a single job cannot depend on a different thing per matrix leg.
#     needs: [guard, image-base, image-cross]
#     runs-on: ubuntu-latest
#     strategy:
#       # Publish whichever architecture succeeded rather than losing both to
#       # one failure: each leg uploads its own asset independently.
#       fail-fast: false
#       matrix:
#         arch: [amd64, arm64]
#     container:
#       # arm64 is cross-compiled on this amd64 runner and so needs the cross
#       # image; amd64 builds natively in the base one.
#       image: ${{ matrix.arch == 'arm64' && needs.image-cross.outputs.ref || needs.image-base.outputs.ref }}
#       credentials:
#         username: ${{ github.actor }}
#         password: ${{ secrets.GITHUB_TOKEN }}
#     steps:
#       - name: Assert this job got the arm64 cross image
#         if: matrix.arch == 'arm64'
#         # First, and before checkout: if this job did not get the cross image,
#         # nothing after it can succeed, and what it fails with points
#         # somewhere else entirely -- `rustc: command not found` when the
#         # container is dropped (an empty image ref), or E0463 "can't find
#         # crate for `core`" when the image expression above falls through: an empty cross-ref makes
#         # `arm64 && '' || base-ref` pick the *base* image, silently. Both were seen on Forgejo run 462 against
#         # a cross image that was published and correct, so the ref itself is
#         # printed: it is the one fact the rest of the log cannot recover.
#         shell: sh
#         env:
#           CROSS_REF: ${{ needs.image-cross.outputs.ref }}
#         run: |
#           echo "cross-ref: '$CROSS_REF'"
#           if [ -z "$CROSS_REF" ]; then
#             echo "::error::needs.image-cross.outputs.ref is empty, so this job is not running in the arm64 cross image. Check that the CI image (arm64 cross) job succeeded and produced a ref."
#             exit 1
#           fi
#           if ! rustup target list --installed 2>/dev/null | grep -qx aarch64-unknown-linux-gnu; then
#             echo "::error::cross-ref is '$CROSS_REF', but this environment has no aarch64-unknown-linux-gnu std (or no rustup on PATH). It is not the image that ref names."
#             exit 1
#           fi
#       - uses: actions/checkout@v4
#
#       - name: Cache cargo registry and build
#         uses: actions/cache@v4
#         with:
#           path: |
