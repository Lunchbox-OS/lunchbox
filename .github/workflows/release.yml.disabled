# DISABLED — commented out, and named `.yml.disabled` so GitHub does not read it.
#
# Both, because commenting alone does not disable a workflow. GitHub parses
# every `.yml` and `.yaml` under .github/workflows/ whatever its contents, and a
# file with no `on:` trigger is an invalid workflow: it reported a startup
# failure against every push, with no jobs and nothing to click into. Only the
# extension keeps it out of that. To re-enable, rename it back to `.yml` and
# uncomment.
#
# Everything it published went to the Forgejo instance the project has left:
# `create-release` and `scripts/ci/upload-release-asset.sh` speak Forgejo's
# release API, and `scripts/ci/publish-apt.sh` pushes into Forgejo's Debian
# registry. After the move those endpoints resolve against `github.server_url`
# — https://github.com — with Forgejo's `/api/v1/...` paths appended, so a `v*`
# tag would build everything and then 404. There is no version of this file
# that works until the destinations are chosen.
#
# It is commented out rather than deleted because the build half is correct and
# worth keeping: the tag-vs-VERSION guard, the per-arch .deb build, the signed
# APK matrix, the F-Droid metadata validation, and the build -> artifacts ->
# single `publish` job restructuring.
#
# Re-enable by uncommenting once these are settled:
#
#   #203  Sign the .deb published with each release
#   #204  Publish releases to a Launchpad PPA
#   #205  Publish the Android apps to f-droid.org proper
#
# and then replace the three publishing steps in `publish` with whatever those
# decide on. Until then nothing here runs, and `v*` tags should not be pushed:
# 18 of them exist locally and are deliberately not on GitHub.
#
# ----------------------------------------------------------------------------

# name: Release
#
# # Tag-driven release pipeline. Pushing a `vX.Y.Z` tag builds the amd64 `.deb`
# # and a signed `.apk` per Android module, then publishes them to a Forgejo
# # release (each asset gets a `.sha256` sidecar).
# #
# # Release flow:
# #   ./scripts/shepherd version set X.Y.Z
# #   git commit -am "bump to X.Y.Z" && git tag -a vX.Y.Z -m vX.Y.Z
# #   git push && git push --tags
# #
# # See docs/ai/history/2026-07-04 003 binary-releases.md for the full design.
# #
# # NOT YET PORTED TO GITHUB. The image pulls below now come from GHCR, but every
# # publishing step still targets the Forgejo instance, which still hosts the
# # releases, the apt registry and the F-Droid repo:
# #   * create-release + upload-release-asset.sh talk to the Forgejo release API
# #   * publish-apt.sh pushes into Forgejo's Debian package registry
# # A `v*` tag pushed to GitHub would therefore run these against
# # git.armeafamily.com. Decide where releases and the apt repo live before
# # tagging here.
# #
# # Shape: every build leg (`deb` per arch, `apk` per module) uploads its package
# # as an artifact, and a single `publish` job at the end creates the release and
# # attaches all of them. Nothing reaches a release until every build has passed.
# #
# # Forgejo could not do this -- it does not implement the upload-artifact@v4
# # protocol (its runner reports as GHES and the action hard-fails) -- so there
# # the release had to be created *first* for the parallel build jobs to attach to,
# # which left a window where a later failure published a half-populated release.
# #
# # Secrets required (the CI images come from GHCR on the ambient GITHUB_TOKEN,
# # so there is no REGISTRY_TOKEN any more):
# #   RELEASE_TOKEN               repo-write PAT to create the release + upload
# #                               assets, used only by `publish`. (Not
# #                               FORGEJO_*/GITEA_*/GITHUB_* — Forgejo reserves
# #                               those prefixes for secret names.)
# #   PACKAGE_TOKEN               PAT with the write:package scope, to publish the
# #                               .deb into Forgejo's Debian (apt) package registry.
# #   SHEPHERD_KEYSTORE_B64       base64 of the Android release keystore
# #   SHEPHERD_KEYSTORE_PASSWORD  keystore password
# #   SHEPHERD_KEY_ALIAS          signing key alias
# #   SHEPHERD_KEY_PASSWORD       signing key password
# #   CLOUDFLARE_API_TOKEN        Cloudflare token with the "Cloudflare Pages:
# #                               Edit" permission, to publish the config editor
# #   CLOUDFLARE_ACCOUNT_ID       Cloudflare account id the Pages project lives in
#
# on:
#   push:
#     tags:
#       - 'v*'
#   # Manual dry run: builds the .deb + both signed .apks (exercising signing and
#   # the media armeabi-v7a cargo-ndk cross-compile) WITHOUT creating a Forgejo
#   # release — unless you tick `publish`. Run it before cutting a real vX.Y.Z tag.
#   workflow_dispatch:
#     inputs:
#       publish:
#         description: "Create the Forgejo release + upload assets (off = dry run)"
#         type: boolean
#         default: false
#
# env:
#   CARGO_TERM_COLOR: always
#
# jobs:
#   # --------------------------------------------------------------------------
#   # guard: the tag must match the canonical VERSION, and all synced literals
#   # must be in harmony (reuses the #83 guarantee).
#   # --------------------------------------------------------------------------
#   guard:
#     name: Guard (tag == VERSION)
#     runs-on: ubuntu-latest
#     steps:
#       - uses: actions/checkout@v4
#
#       # Only meaningful for a tag push; a manual dry run has no vX.Y.Z ref.
#       - name: Tag matches VERSION
#         if: github.event_name == 'push'
#         run: |
#           tag_version="${GITHUB_REF_NAME#v}"
#           file_version="$(./scripts/shepherd version)"
#           if [ "$tag_version" != "$file_version" ]; then
#             echo "::error::tag $GITHUB_REF_NAME (=$tag_version) does not match VERSION ($file_version)"
#             exit 1
#           fi
#           echo "Releasing version $file_version"
#
#       - name: Version harmony
#         run: ./scripts/shepherd version check
#
#   # --------------------------------------------------------------------------
#   # images: build-if-missing the pre-baked CI images and expose their refs. One
#   # call per image, so a job waits only for the image it pulls -- see the note in
#   # ci.yml, and image.yml's own header, for why that is worth the three calls.
#   # --------------------------------------------------------------------------
#   image-base:
#     name: CI image
#     needs: guard
#     uses: ./.github/workflows/image.yml
#     with:
#       kind: base
#     permissions:
#       packages: write
#     secrets: inherit
#
#   image-android:
#     name: CI image (Android)
#     needs: image-base
#     uses: ./.github/workflows/image.yml
#     with:
#       kind: android
#       base-ref: ${{ needs.image-base.outputs.ref }}
#     permissions:
#       packages: write
#     secrets: inherit
#
#   image-cross:
#     name: CI image (arm64 cross)
