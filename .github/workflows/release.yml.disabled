#             /usr/local/cargo/git
#             target
#           key: ${{ runner.os }}-cargo-v2-${{ matrix.arch }}-${{ hashFiles('**/Cargo.lock') }}
#           restore-keys: |
#             ${{ runner.os }}-cargo-v2-${{ matrix.arch }}-
#
#       - name: Build .deb
#         # Builds --release, stages via `DESTDIR=… shepherd install …`, runs
#         # dpkg-deb. Root in the container, so no fakeroot. Output in dist/pkg/.
#         run: ./scripts/shepherd package deb --arch ${{ matrix.arch }} --out dist/pkg
#
#       - name: Assert the package is labelled for the right architecture
