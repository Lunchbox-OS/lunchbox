#           fi
#           [ -n "$id" ] && [ "$id" != "null" ] || { echo "::error::could not determine release id"; exit 1; }
#           echo "release_id=$id" >> "$GITHUB_OUTPUT"
#           echo "release id=$id"
#
#       - name: Upload every asset to the release
#         env:
#           SERVER_URL: ${{ github.server_url }}
#           REPO: ${{ github.repository }}
#           RELEASE_TOKEN: ${{ secrets.RELEASE_TOKEN }}
#           RELEASE_ID: ${{ steps.rel.outputs.release_id }}
#         run: ./scripts/ci/upload-release-asset.sh dist/pkg/*.deb dist/pkg/*.apk
#
#       # The apt registry gets the .debs too, so users have an
#       # `apt update`/`apt upgrade` path; the release assets stay the
#       # offline/manual download. One invocation for both arches: the registry
#       # reads `Architecture:` out of each control file and serves both from one
#       # distribution/component, and it signs the repository metadata itself, so
#       # the .deb needs no signing. Prereleases (tags with a `-`, e.g. v0.2.0-rc1)
#       # are skipped so RC builds never reach `apt upgrade` users -- they still
#       # get the signed release asset for manual testing. See docs/INSTALL.md.
