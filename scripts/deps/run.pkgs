# Runtime system packages for shepherd-launcher
# These are required to run the compiled binaries
# One package per line, comments start with #

# Sway compositor (required for kiosk mode)
sway

# Wayland session utilities
swayidle
xdg-desktop-portal-wlr

# Output mirroring for external monitor / docking support (issue #87). sway
# cannot mirror outputs from config, so lunchboxd drives `wl-mirror` (a
# screencopy client) to clone the primary panel onto a docked display. Audio
# routing while docked uses `pw-dump`/`wpctl` from PipeWire/WirePlumber, which
# the volume control already depends on.
wl-mirror

# Runtime libraries (may be pulled in automatically, but explicit is safer)
libgtk-4-1
libadwaita-1-0
libgtk4-layer-shell0
libudev1

# mpv runtime (libmpv2 is linked dynamically by lunchbox-media; mpv brings in
# both the binary and the .so).
#
# mpv also needs a libva driver to decode video on the GPU, and neither depends
# on nor recommends one. Which driver is right depends on the GPU, so they are
# not listed here — `shepherd deps install run` picks them from the detected
# hardware via install_media_deps in scripts/lib/admin.sh (also reachable as
# `shepherd-admin va-api install`).
mpv

# Python venv support — needed to create the yt-dlp virtualenv.
# yt-dlp itself is installed via pip into /opt/shepherd/ytdlp-venv so it
# stays up-to-date independent of the Ubuntu package archive.
python3-venv

# Screen brightness control — used by lunchboxd's brightness adapter to
# write `/sys/class/backlight/<dev>/brightness` from an unprivileged user.
# Apt installs udev rules that grant the `video` group write access, which
# is the only supported path; a direct sysfs write would silently fail in
# production. On hosts with no backlight (most desktops) the package is
# installed but never invoked.
brightnessctl

# Bluetooth stack — BlueZ provides the bluetoothd D-Bus service the
# BLE management transport (lunchbox-ble) talks to via the bluer crate.
bluez
