# Runtime system packages for shepherd-launcher
# These are required to run the compiled binaries
# One package per line, comments start with #

# Sway compositor (required for kiosk mode)
sway

# Wayland session utilities
swayidle
xdg-desktop-portal-wlr

# Runtime libraries (may be pulled in automatically, but explicit is safer)
libgtk-4-1
libadwaita-1-0
libgtk4-layer-shell0
libudev1

# mpv runtime (libmpv2 is linked dynamically by shepherd-media; mpv brings in
# both the binary and the .so)
mpv

# Python venv support — needed to create the yt-dlp virtualenv.
# yt-dlp itself is installed via pip into /opt/shepherd/ytdlp-venv so it
# stays up-to-date independent of the Ubuntu package archive.
python3-venv
