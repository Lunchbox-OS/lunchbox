# Test-time system packages for Lunchbox
# These are needed in addition to the build deps to run the
# `lunchbox-e2e` end-to-end suite, which boots a real headless
# Sway compositor and the lunchbox binaries inside a temp environment.
# One package per line, comments start with #

# Sway compositor (the harness drives a real Sway, not a mock)
sway

# wlroots headless backend pulls in dbus indirectly, but the harness
# isolates each test with its own runtime dir so we want the binary
# available explicitly.
dbus-daemon

# `coreutils` provides /usr/bin/sleep, which the test entries spawn as a
# stand-in for a real activity. It's almost always installed already, but
# list it for completeness.
coreutils

# `mkfs.vfat`, for the loopback FAT images the file manager's removable-drive
# tests run against (scripts/integration-tests/setup-removable-dev.sh). Those
# tests are `#[ignore]`d and skip cleanly without it, so this is only needed on
# a machine that means to run them.
dosfstools

# `mountpoint` and `findmnt`, which the same scripts use to refuse to run
# against an unmounted directory -- a check that matters, because an empty
# /media/lunchbox-fat on ext4 would pass the tests for the wrong reason.
util-linux
